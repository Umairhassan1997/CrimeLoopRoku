<component name="VideoItem" extends="Group">
    <script type="text/brightscript" uri="VideoItem.brs" />
    <interface>
        <field id="itemContent" type="node" onChange="onItemContent" />
        <field id="focusPercent" type="float"  />
        <field id="gridHasFocus" type="boolean"  />

    </interface>
    <children>

      
       
         <MaskGroup
      id = "exampleMaskGroup"
      masksize = "[ 409, 230 ]"
      translation="[4,4]"
      
      maskuri = "pkg:/images/mask.png" > 
        <Poster loadWidth="409" loadHeight="230" loadDisplayMode="scaletoZoom" id="thumbnailPoster" translation="[0,0]" width="409" height="230" />
        </MaskGroup>
        <Label id="videoTitle" translation="[20,240]" width="309" height="67" vertAlign="center" horizAlign="left" wrap="true" maxLines="2" color="#FFFFFF" >
                <Font role="font" uri="pkg:/components/Fonts/Roboto-Regular.ttf" size="22" />

            </Label>

                            <Poster id="badge" uri="pkg:/images/badge.png" translation="[270,10]" width="137" height="73"  />
                            <Poster id="newBadge" uri="pkg:/images/new.png" translation="[10,10]" width="137" height="73"  />


    </children>
    
</component>