         <Navbar id="navbar" />

           <Animation id="heroUpAnim"
       duration="0.1"
       repeat="false"
       easeFunction="linear" >
    <Vector2DFieldInterpolator 
        key="[0.0, 1.0]"
        keyValue="[ [0.0, 0.0], [0.0, -1000.0] ]"
    fieldToInterp="heroGroup.translation" />
</Animation>

<Animation id="herodownAnim"
       duration="0.1"
       repeat="false"
       easeFunction="linear" >
    <Vector2DFieldInterpolator 
        key="[0.0, 1.0]"
        keyValue="[  [0.0, -1000.0], [0.0, 0.0] ]"
    fieldToInterp="heroGroup.translation" />
</Animation>

<Animation id="videosUpAnim"
       duration="0.1"
       repeat="false"
       easeFunction="linear" >
    <Vector2DFieldInterpolator 
        key="[0.0, 1.0]"
        keyValue="[ [0,0], [0.0, -460.0] ]"
    fieldToInterp="videosGroup.translation" />
</Animation>

<Animation id="videosdownAnim"
       duration="0.1"
       repeat="false"
       easeFunction="linear" >
    <Vector2DFieldInterpolator 
        key="[0.0, 1.0]"
        keyValue="[  [0.0, -460.0], [0,0] ]"
    fieldToInterp="videosGroup.translation" />
</Animation>


            <Video
            id="VideoPlayer"
            translation="[0,0]"
            visible="false"
        />
    </children>
    
</component>