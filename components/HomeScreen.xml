                focusBitmapUri="pkg:/images/btnCat5F.png"
                focusFootprintBitmapUri="pkg:/images/btnCat5UF.png" showFocusFootprint="true" />
            <Button id="btnCat6" focusable="true" iconUri=""
                text="" focusedIconUri="" visible="false" translation="[1413, 520]"
