            translation="[238,0]"
            itemSpacing="[2000,2000]"
            itemSize="[1673,506]"
            rowItemSize = "[ [1673, 506]]"
             rowItemSpacing="[[22,40]]"
            numRows="2"
            rowFocusAnimationStyle ="fixedFocus"
            drawFocusFeedback="false"
         />
 <Group id="heroGroup" translation="[0,0]" inheritParentTransform = "true">

           <MaskGroup
      
      masksize = "[ 1682, 506 ]"
      translation="[238,0]"
      
      maskuri = "pkg:/images/heroMask.png" >  
        <Poster scaleRotateCenter="[836,253]"  loadDisplayMode="scaleToZoom"  id="thumbnailPoster" translation="[0,0]" width="1682" height="506" />
        </MaskGroup>
       
                <Label id="videoTitle" visible="true" translation="[238,306]" width="744" height="200" wrap="true"  maxLines="2" >
                     <Font role="font" uri="pkg:/components/Fonts/Inter-Bold.otf" size="56" />

                    </Label>

                    </Group>

             


         <Group id="dotGroup" visible="false">
         <Poster translation="[1498,664]" width="160" height="40" uri="pkg:/images/dotbg.png" />
