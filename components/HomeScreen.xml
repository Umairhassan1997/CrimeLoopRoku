<component name="HomeScreen" extends="Group">
    <script type="text/brightscript" uri="HomeScreen.brs" />
    <script type="text/brightscript" uri="Navbar.brs" />
    <interface>
                        <field id="isTrialExpired" type="boolean" onChange="showSubPopup" />

    </interface>
    <children>
      
      <Poster uri="pkg:/images/BG.png" translation="[0,0]" width="1920" height="1080" />
